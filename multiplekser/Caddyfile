# Konfiguracja Caddy (patrz docker-compose.prod.yml, usluga `caddy`). DOMAIN pochodzi ze
# zmiennej srodowiskowej (.env) - ustaw prawdziwa domene z rekordem A na IP serwera, zeby Caddy
# automatycznie wystawil zaufany certyfikat HTTPS (Let's Encrypt), bez zadnej dodatkowej
# konfiguracji. Wartosc domyslna ":80" dziala od razu po samym IP serwera, ale bez szyfrowania.
{$DOMAIN} {
	# Kalkulator terminu - osobny projekt (kontener `kalkulator-web`), wystawiony pod
	# /kalkulator-terminu na tej samej domenie co Multiplekser (bez osobnej subdomeny).
	# handle_path usuwa prefiks /kalkulator-terminu przed przekazaniem zadania dalej, wiec
	# aplikacja kalkulatora widzi zadania tak, jakby stala pod "/" - wymaga, zeby kalkulator
	# nie generowal wlasnych bezwzglednych URLi zakladajacych root (patrz uwaga w README.md).
	# Kontener `kalkulator-web` musi byc podpiety do tej samej sieci Dockera co `caddy` -
	# patrz siec `multiplekser-shared` w docker-compose.prod.yml.
	handle_path /kalkulator-terminu/* {
		reverse_proxy kalkulator-web:8000
	}

	# Kalkulator serwuje wlasne pliki statyczne (Whitenoise) pod bezwzglednym /static/ (Django
	# STATIC_URL), niezaleznie od prefiksu /kalkulator-terminu/ ktorego strona jest wystawiona -
	# stad osobny blok bez path-strippingu, zeby CSS/JS kalkulatora sie ladowaly.
	handle /static/* {
		reverse_proxy kalkulator-web:8000
	}

	# BEGIN PAWILONOS
	redir /PawilonOs /PawilonOs/ 308

	handle_path /PawilonOs/* {
		reverse_proxy pawilonos-web:8000
	}
	# END PAWILONOS

        # BEGIN SALDEO
        redir /saldeo /saldeo/ 308

        handle /saldeo/* {
                reverse_proxy saldeo-test-app:8080
        }
        # END SALDEO

	# BEGIN REKLAMACJEOS
	redir /reklamacjeOS /reklamacjeOS/ 308

	handle_path /reklamacjeOS/* {
		reverse_proxy reklamacjeos-backend:8000
	}
	# END REKLAMACJEOS

	# BEGIN KONFIGURATOR3D
	redir /konfigurator3d /konfigurator3d/ 308

	handle_path /konfigurator3d/* {
		reverse_proxy konfigurator3d-web:80
	}
	# END KONFIGURATOR3D

	# BEGIN ONEDRIVE REPORT PROXY
	handle_path /api/raport-onedrive/* {
		reverse_proxy onedrive-report-proxy:3000
	}
	# END ONEDRIVE REPORT PROXY

	# BEGIN PLYTYOS
	redir /plytyOS /plytyOS/ 308

	handle_path /plytyOS/* {
		reverse_proxy plytyos-app:8000
	}
	# END PLYTYOS

	handle {
		reverse_proxy web:80
	}
}
