# Szablon zmiennych srodowiskowych do lokalnego uruchomienia backendu BEZ Dockera (patrz
# README.md, "Szybki start (lokalnie, bez Dockera)"). Skopiuj do .env (`cp .env.example .env`)
# w tym katalogu i uzupelnij. Plik .env NIE trafia do repozytorium (patrz .gitignore w root).
#
# Uruchomienie przez `docker compose up` NIE potrzebuje tego pliku - docker-compose.yml sam
# ustawia wszystkie zmienne dla kontenerow. Ten szablon jest dla dewelopera odpalajacego
# `uvicorn`/`pytest`/`celery` recznie na wlasnym komputerze, przeciwko wlasnemu
# Postgresowi/Redisowi/MinIO.

# Postgres - domyslna wartosc ponizej to te same dane logowania, co w docker-compose.yml
# (bezpieczne do trzymania tu jawnie - to znany, publiczny placeholder dewelopcerski, nie sekret
# produkcyjny). Zmien tylko jesli Twoj lokalny Postgres ma inne dane logowania/port.
DATABASE_URL=postgresql://multiplekser:multiplekser_dev@localhost:5432/multiplekser

# Redis - broker Celery ORAZ magazyn licznikow rate limitingu logowania (/auth/token) od Etapu
# "quick winy" - wymagany takze do uruchomienia testow (patrz tests/conftest.py).
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-kompatybilny storage plikow dokumentow) - domyslne dane logowania z docker-compose.yml.
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=multiplekser-dokumenty

# JWT - mozna zostawic puste do lokalnego dewelopmentu (kod ma wtedy wlasny, jawnie oznaczony
# jako niebezpieczny domyslny sekret - patrz app/core/config.py). Ustaw na losowy, dlugi string
# (np. `openssl rand -hex 32`) TYLKO jesli ten backend bedzie kiedykolwiek osiagalny spoza
# Twojego komputera - do prawdziwej produkcji sluzy osobny szablon: ../.env.prod.example.
JWT_SECRET_KEY=

# Klucze Gemini (Google AI Studio) - bez nich upload dokumentow konczy sie statusem "error".
# NIGDY nie wpisuj tu prawdziwych kluczy do repozytorium - ten plik jest tylko SZABLONEM.
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_PAID=

# Opcjonalne dostrojenie OCR (domyslne wartosci ponizej - patrz app/core/config.py, dlaczego
# akurat takie).
# OCR_TIMEOUT_SECONDS=90
# OCR_IMAGE_MAX_SIDE=2600
# OCR_IMAGE_QUALITY=95
