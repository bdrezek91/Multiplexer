# Szablon sekretow dla docker-compose.prod.yml - skopiuj do .env (`cp .env.prod.example .env`)
# i uzupelnij wartosciami. Plik .env NIE powinien trafic do repozytorium (sekrety!) - dodaj go do
# .gitignore jesli jeszcze go tam nie ma.

# Postgres
POSTGRES_USER=multiplekser
POSTGRES_PASSWORD=zmien-to-na-losowe-haslo
POSTGRES_DB=multiplekser

# MinIO / S3
MINIO_ROOT_USER=zmien-to-login
MINIO_ROOT_PASSWORD=zmien-to-na-losowe-haslo-min-8-znakow

# JWT - WYMAGANY, losowy, dlugi sekret (np. `openssl rand -hex 32`). Wartosc domyslna w kodzie
# (patrz app/core/config.py) jest TYLKO do dewelopmentu lokalnego - patrz docs/RAPORT_ETAP_5.md.
JWT_SECRET_KEY=

# Klucze Gemini (Google AI Studio) - bez nich upload dokumentow konczy sie statusem "error".
# NIGDY nie wpisuj tu prawdziwych kluczy do repozytorium - ten plik jest tylko SZABLONEM.
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_PAID=

# Klucz OpenAI (platform.openai.com) - OPCJONALNY, wylacznie do niezaleznego cross-checku
# wyniku Gemini (patrz backend/app/modules/ocr/crosscheck.py) - rozbiezne pozycje miedzy
# dwoma dostawcami sa oznaczane "do weryfikacji", Gemini zostaje jedynym zrodlem prawdy.
# Bez tego klucza cross-check jest po prostu pomijany, dokumenty dzialaja normalnie na Gemini.
OPENAI_API_KEY=
# Model do cross-checku - domyslnie "gpt-4o" (pelny, nie "mini" - w tescie na gestym, odrecznym
# formularzu mini znajdowal zaledwie ulamek pozycji, robiac flagowanie bezuzytecznym). Drozszy
# niz mini, ale mozna nadpisac na dowolny inny model OpenAI wspierajacy obrazy/PDF.
OPENAI_MODEL=gpt-4o

# Domena publiczna (Caddy) - jesli masz juz domene z rekordem A wskazujacym na IP tego serwera,
# wpisz ja tutaj (np. multiplekser.twojafirma.pl) - Caddy automatycznie wystawi darmowy, zaufany
# certyfikat HTTPS (Let's Encrypt), bez zadnej dodatkowej konfiguracji. Bez domeny zostaw
# domyslne ":80" - strona dziala od razu po samym adresie IP serwera, ale bez szyfrowania (HTTP).
# Zmiana pozniej (gdy juz kupisz domene) = wpisz ja tutaj i `docker compose -f
# docker-compose.prod.yml up -d` jeszcze raz - certyfikat pojawi sie automatycznie.
DOMAIN=:80

# Opcjonalne dostrojenie
# WEB_CONCURRENCY=2   # liczba procesow uvicorn w kontenerze backend
